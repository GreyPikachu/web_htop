[Unit]
Description=web_htop Linux telemetry server
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/web_htop_server --bind 127.0.0.1
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
# Do not enable ProtectProc=invisible: it would hide the processes being monitored.
# Permissions/hidepid may still make a subset of process data unavailable.

[Install]
WantedBy=multi-user.target
